# Cấu hình cục bộ cho các script ở thư mục scripts/.
# Sao chép thành .env rồi tự điền giá trị; không commit file .env.

# Bắt buộc khi chạy migration hoặc deploy Supabase bằng script cục bộ.
SUPABASE_ACCESS_TOKEN=

# Chỉ cần cho các script đồng bộ cũ gọi trực tiếp Supabase.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Chỉ cần cho script cũ đọc WMS trực tiếp khi được người dùng yêu cầu.
WMS_ACCESS_TOKEN=

# Khoá AI như GEMINI_API_KEY và ANTHROPIC_API_KEY phải được cấu hình trong
# Supabase Edge Functions Secrets, không đặt trong file này.
