# Generated internal data
data/*.db
data/*.db-shm
data/*.db-wal
data/*.xlsx
data/*.xls
data/*.csv

# Python cache
__pycache__/
*.py[cod]

# Local secrets
.env
.env.*

# Cấu hình chạy cục bộ (launch.json chứa đường dẫn tuyệt đối của từng máy)
# Thu muc .claude: bo qua cau hinh may (launch.json, worktrees, lock) nhung giu ho so agent + skill cua doi (16/10/2026)
.claude/*
!.claude/agents/
!.claude/skills/

# Đoạn JS sinh ra bởi refresh_skus.py snippet — chạy lại lúc nào cũng có
sku-refresh-snippet.js

# Export SKU tải về gốc repo: dữ liệu SKU thật, không được lên Git
/*.xlsx
/*.xls

# Nhật ký thay đổi nội bộ: giữ trên máy, không đưa lên repo public
/RULES.md

# Kết quả chạy script và export (chứa dữ liệu SKU, Group UID thật) cùng thư mục nháp: giữ trên máy
/outputs/
/tmp/

# Bộ nhớ đệm của Supabase CLI
/supabase/.temp/

# Gói nén extension để gửi sang máy khác (đóng lại từ thư mục extension khi cần)
/extension/*.rar

# Thư viện chỉ dùng khi chạy test (axe-core) — cài bằng npm install, không commit
node_modules/
