{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/claude_hooks.py\" commit",
            "timeout": 120,
            "statusMessage": "Cổng trước commit"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/claude_hooks.py\" files",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
