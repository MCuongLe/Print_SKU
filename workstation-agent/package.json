{
  "name": "@hasaki/print-sku-agent",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "description": "Agent Windows độc lập để in tem SKU và Group UID trên TSC PE200.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "preview:sku": "node src/cli.mjs preview --type sku",
    "preview:uid": "node src/cli.mjs preview --type group_uid",
    "dry-run:sku": "node src/cli.mjs dry-run --type sku",
    "dry-run:uid": "node src/cli.mjs dry-run --type group_uid",
    "service": "node src/cli.mjs service",
    "diagnose": "node src/cli.mjs diagnose"
  },
  "dependencies": {
    "@img/sharp-win32-x64": "0.35.3",
    "sharp": "0.35.3"
  }
}
