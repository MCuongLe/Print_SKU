{
  "manifest_version": 3,
  "name": "HASAKI Inside PO Connector",
  "version": "0.3.1",
  "description": "Cầu nối chỉ đọc để lấy PO, danh mục SKU và quan hệ Combo từ phiên Inside đang đăng nhập.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://inside.mastige.vn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://mcuongle.github.io/Print_SKU/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://inside.mastige.vn/*"
      ],
      "js": [
        "sku-sync-core.js",
        "inside-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
